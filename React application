import { useState } from "react";

export default function App() {
  const [color, setColor] = useState("#ffffff");

  const generate = () => {
    setColor(
      "#" +
      Math.floor(Math.random() * 16777215)
        .toString(16)
    );
  };

  return (
    <div
      style={{
        height: "100vh",
        background: color
      }}
    >
      <button onClick={generate}>
        Generate Color
      </button>
    </div>
  );
}
