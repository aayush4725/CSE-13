export default function App() {
  const data = [
    ["Monday", "Math"],
    ["Tuesday", "Science"],
    ["Wednesday", "English"],
    ["Thursday", "Computer"],
    ["Friday", "Sports"]
  ];

  return (
    <div>
      <h1>Student Timetable</h1>

      <table border="1">
        <thead>
          <tr>
            <th>Day</th>
            <th>Subject</th>
          </tr>
        </thead>

        <tbody>
          {data.map((item, i) => (
            <tr key={i}>
              <td>{item[0]}</td>
              <td>{item[1]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}
